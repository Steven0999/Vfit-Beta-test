# Copy to .env.vfit-app-pro and replace these placeholders before deployment.
# Each Price must be active, GBP, monthly: Basic £4.99, Platinum £18.99,
# 1-to-1 Coaching £97.99. Create new Prices for these amounts in Stripe.
STRIPE_BASIC_PRICE_ID=price_basic_placeholder
STRIPE_PLATINUM_PRICE_ID=price_platinum_placeholder
STRIPE_COACHING_PRICE_ID=price_coaching_placeholder
# Public HTTPS page visible in the phone browser after Stripe redirects.
VFIT_APP_URL=https://your-vfit-origin.example/
